# Training-only Beam image. CUDA 12.9 is compatible with Beam's A10G fleet and
# supports the Blackwell GPUs available through serverless and on-demand pools.
# Source code and datasets are synchronized by Beam at invocation time.
FROM nvidia/cuda:12.9.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    FLASH_ATTENTION_FORCE_BUILD=TRUE \
    FLASH_ATTN_CUDA_ARCHS="80;90;100;120" \
    MAX_JOBS=4 \
    NATTEN_CUDA_ARCH="8.0;8.6;8.9;9.0;10.0;12.0" \
    NATTEN_N_WORKERS=4 \
    PYTHONUNBUFFERED=1 \
    TORCH_CUDA_ARCH_LIST="8.0 8.6 8.9 9.0 10.0 12.0"

RUN apt-get update && apt-get install --no-install-recommends -y \
    build-essential \
    cmake \
    ffmpeg \
    git \
    libgl1 \
    libglib2.0-0 \
    python3.12 \
    python3-dev \
    python3-pip \
    python3-setuptools \
    python3-venv \
    python3-wheel \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3 /usr/bin/python

# Keep these versions aligned with manager/spec.py and docker/Dockerfile.
RUN pip install --no-cache-dir --break-system-packages \
    torch==2.13.0 \
    torchvision==0.28.0 \
    torchaudio==2.11.0 \
    --index-url https://download.pytorch.org/whl/cu129

COPY requirements.txt requirements_base.txt /tmp/ai-toolkit-requirements/
RUN pip install --no-cache-dir --break-system-packages \
    -r /tmp/ai-toolkit-requirements/requirements.txt

# NATTEN does not publish a torch 2.13 / CUDA 12.9 wheel. Build both CUDA
# extensions against the selected PyTorch/CUDA toolchain to keep one image
# compatible across the supported Beam GPU generations.
RUN pip install --no-cache-dir --break-system-packages -U ninja packaging \
    && pip install --no-cache-dir --break-system-packages --no-build-isolation \
        torchcodec==0.15.0 \
        natten==0.21.7 \
        flash-attn==2.8.3 \
    && python -c "import flash_attn, natten, torchcodec; print('accelerators OK:', flash_attn.__version__, natten.__version__, torchcodec.__version__)"

WORKDIR /mnt/code
